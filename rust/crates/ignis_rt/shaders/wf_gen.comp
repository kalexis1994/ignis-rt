#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
#include "pathtracer_common.glsl"
#include "wf_pathstate.glsl"
// ── Wavefront path tracer — Stage 1: ray generation ─────────────────────────────────────────────
// One thread/pixel writes the (jittered) primary ray + the initial PathCtx into the PathState buffer.
// The per-bounce extend stage then advances each path one real bounce per dispatch. Empty scene =>
// the path is born dead carrying the sky. See the wavefront plan in memory.

layout(local_size_x = 64) in;

void main() {
    uvec2 dims = pc.dims;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= dims.x * dims.y) return;
    uint frame = uint(pc.sunCol.w);
    bool rrMode = (pc.hasTlas & 8u) != 0u;    // DLSS Ray Reconstruction active this frame
    bool useRaster = (pc.hasTlas & 128u) != 0u; // bit7: a rasterized primary hit is available
    g_sampleIdx = frame;
    uint px = idx % dims.x, py = idx / dims.x;

    // Sub-pixel jitter. Hybrid raster rasterizes at pixel centres (no jitter) so we match it; else in
    // RR mode the deterministic Halton offset NGX also gets, otherwise a random offset for AA.
    uint jrng = ((px * 1973u) ^ (py * 9277u) ^ 0x9e3779b9u) | 1u;
    vec2 jitter = useRaster ? vec2(0.5)
                : (rrMode ? (vec2(0.5) + pc.jitter) : ((frame == 0u) ? vec2(0.5) : rand2(jrng)));
    vec2 uv  = (vec2(px, py) + jitter) / vec2(dims);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 world = pc.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 ro = pc.camPos.xyz;
    vec3 rd = (abs(world.w) >= 1e-8) ? normalize(world.xyz / world.w - ro) : vec3(0.0, 0.0, 1.0);
    // Ray-cone spread angle (angular size of one pixel); constant for the whole path.
    vec2 uvY = (vec2(px, py) + jitter + vec2(0.0, 1.0)) / vec2(dims);
    vec4 wY = pc.invViewProj * vec4(uvY.x * 2.0 - 1.0, 1.0 - uvY.y * 2.0, 1.0, 1.0);
    float spreadAngle = length(normalize(wY.xyz / wY.w - ro) - rd);

    // DLSS-RR guide buffers (depth/normal/albedo/motion) via the deterministic PSR walk, same as the
    // megakernel — written only in RR mode (the stochastic colour path would jitter them).
    if (rrMode && (pc.hasTlas & 1u) != 0u) writeGuidePSR(uvec2(px, py), ro, rd);

    PathCtx c;
    c.ro = ro; c.rd = rd; c.tp = vec3(1.0); c.L = vec3(0.0);
    c.coneWidth = 0.0; c.pathRough = 0.0;
    c.b = 0; c.glassBounces = 0; c.glassDepth = 0;
    c.isDiffuse = false; c.lastDiffuse = false;
    // Path scramble key — the extend stage advances this across dispatches (NEE + bounce sampling).
    uint rng = ((px * 1973u) ^ (py * 9277u) ^ 0x68bc21ebu) | 1u;

    bool noScene = (pc.hasTlas & 1u) == 0u;
    bool dead = noScene;
    if (noScene) {
        c.L = sky(rd);             // empty scene: born dead carrying the sky
        noRasterHit(idx);
    } else if (useRaster) {
        // Read the rasterized primary hit; reconstruct its barycentrics so traceBounce can skip the
        // primary ray query. A cleared hit (0xFFFFFFFF) means the primary escaped -> sky, born dead.
        uvec2 hit = imageLoad(gHit, ivec2(px, py)).xy;
        if (hit.x == 0xFFFFFFFFu) {
            c.L = sky(rd); dead = true;
            noRasterHit(idx);
        } else {
            vec3 wpos = imageLoad(gPos, ivec2(px, py)).xyz;
            mat4x3 o2w = rasterO2W(hit.x);
            vec2 bc = reconstructBary(rasterInsts.data[hit.x].customIndex, hit.y, o2w, wpos);
            storeRasterHit(idx, hit.x, hit.y, bc, wpos);
        }
    } else {
        noRasterHit(idx);
    }
    storePath(idx, c, rng, spreadAngle, dead);

    // Seed round 0's live queue (half 0) with the identity mapping; the CPU sets count0 = N. Dead
    // (empty-scene) paths stay in the queue but early-out in extend, so they never get re-appended.
    wfq.q[idx] = idx;
}
