#version 460
#extension GL_EXT_scalar_block_layout : require
// ── Wavefront path tracer — Stage 1: ray generation ─────────────────────────────────────────────
// Phase 0 scaffolding: one thread per pixel writes the primary ray + initial path state into the
// PathState buffer. Later stages (extend/shade) consume it. The megakernel (trace.rgen) is unchanged
// and stays the default; this path is gated by the use_wavefront flag. See [[wavefront-plan]].

layout(local_size_x = 64) in;

// One path in flight. 64 bytes (4 vec4), std430. ro.w carries the pixel index (bit-cast); rd.w holds
// path flags (bounce/glassDepth/...); tp = throughput; rad = accumulated radiance.
struct PathState {
    vec4 ro;   // xyz origin, w = pixel index (uintBitsToFloat)
    vec4 rd;   // xyz direction, w = flags
    vec4 tp;   // xyz throughput, w = pathRough
    vec4 rad;  // xyz radiance, w = rng seed (uintBitsToFloat)
};
layout(binding = 19, std430) buffer PathStates { PathState s[]; } paths;

// Prefix of CameraPush (shared pipeline layout) — only the fields ray generation needs.
layout(push_constant) uniform PC {
    mat4  invViewProj;
    vec4  camPos;
    uvec2 dims;
} pc;

uint pcg(uint v) { uint s = v*747796405u + 2891336453u; uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u; return (w >> 22u) ^ w; }

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.dims.x * pc.dims.y;
    if (idx >= total) return;

    uint px = idx % pc.dims.x;
    uint py = idx / pc.dims.x;
    vec2 uv  = (vec2(px, py) + 0.5) / vec2(pc.dims);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 world = pc.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 ro = pc.camPos.xyz;
    vec3 rd = (abs(world.w) >= 1e-8) ? normalize(world.xyz / world.w - ro) : vec3(0.0, 0.0, 1.0);

    paths.s[idx].ro  = vec4(ro, uintBitsToFloat(idx));
    paths.s[idx].rd  = vec4(rd, uintBitsToFloat(0u));               // flags = 0 (bounce 0)
    paths.s[idx].tp  = vec4(1.0, 1.0, 1.0, 0.0);                    // throughput 1, pathRough 0
    paths.s[idx].rad = vec4(0.0, 0.0, 0.0, uintBitsToFloat(idx * 9781u + 1u)); // radiance 0, rng seed
}
