#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
#include "pathtracer_common.glsl"
#include "wf_pathstate.glsl"
// ── Wavefront path tracer — Stage 3: resolve ────────────────────────────────────────────────────
// After all per-bounce extend dispatches, every path's final radiance lives in PathCtx.L. This stage
// reads it, does the firefly clamp + temporal accumulation, and tonemaps to the offscreen — the
// non-RR output path (Phase 1c bypasses DLSS). The ray_query extension is enabled only because the
// shared include declares traceBounce; this stage never traces.

layout(local_size_x = 64) in;

void main() {
    uvec2 dims = pc.dims;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= dims.x * dims.y) return;
    uint frame = uint(pc.sunCol.w);
    bool rrMode = (pc.hasTlas & 8u) != 0u; // DLSS Ray Reconstruction active this frame
    bool hasLut = (pc.hasTlas & 2u) != 0u;
    ivec2 p = ivec2(int(idx % dims.x), int(idx / dims.x));

    uint rng; float spreadAngle; bool dead;
    PathCtx c = loadPath(idx, rng, spreadAngle, dead);

    if (rrMode) {
        // DLSS-RR: emit the noisy 1-spp linear radiance to gNoisy (no accumulation/tonemap). NGX
        // denoises it temporally using the guide buffers + motion vectors; a separate pass tonemaps the
        // clean output. Sanitize NaN/Inf + hue-preserving firefly clamp, matching the megakernel.
        vec3 col = c.L;
        col = mix(col, vec3(0.0), isnan(col));
        col = mix(col, vec3(0.0), isinf(col));
        col = max(col, vec3(0.0));
        const float MAX_RADIANCE = 30.0;
        float maxC = max(col.r, max(col.g, col.b));
        if (maxC > MAX_RADIANCE) col *= MAX_RADIANCE / maxC;
        // Samples/Pixel: average the spp samples of this frame into gNoisy (reset on the first sample);
        // DLSS reads it once, after the last sample, so it denoises a cleaner spp-averaged input.
        uint spp = max(pc.spp, 1u);
        vec3 prev = (pc.sampleIdx == 0u) ? vec3(0.0) : imageLoad(gNoisy, p).rgb;
        imageStore(gNoisy, p, vec4(prev + col / float(spp), 1.0));
        return;
    }

    // Non-RR: firefly clamp + progressive accumulation + tonemap. The global sample index counts every
    // SPP sample across every frame, so spp>1 just converges the same accumulator faster.
    vec3 L = min(c.L, vec3(16.0));
    uint gs = frame * max(pc.spp, 1u) + pc.sampleIdx;
    vec3 accum = (gs == 0u) ? L : imageLoad(accumImage, p).rgb + L;
    imageStore(accumImage, p, vec4(accum, 1.0));
    vec3 hdr = accum / float(gs + 1u);
    vec3 display = hasLut ? tonemapLut(hdr) : aces(hdr);
    imageStore(outImage, p, vec4(display, 1.0));
}
