#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
// Path tracer (RT): multi-bounce GI via ray query, next-event estimation for the sun and
// scene lights, cosine-weighted diffuse bounces, and temporal accumulation (averaged across
// frames, reset when the camera moves). The hemispheric ambient is gone — indirect light now
// comes from real bounces (color bleeding, contact darkening, sky fill via escaping rays).

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba32f) uniform image2D outImage;
layout(binding = 1) uniform accelerationStructureEXT tlas;

layout(buffer_reference, std430) readonly buffer Verts { float v[]; };
layout(buffer_reference, std430) readonly buffer Norms { float n[]; };
layout(buffer_reference, std430) readonly buffer Uvs   { float u[]; };
layout(buffer_reference, std430) readonly buffer Indices { uint i[]; };
layout(buffer_reference, std430) readonly buffer MatIds  { uint m[]; };
struct GeomDesc { uint64_t vtx; uint64_t idx; uint64_t nrm; uint64_t mat; uint64_t uv; uint64_t pad; };
struct Material { vec4 albedo; uvec4 tex; vec4 params; }; // tex.x=diffTex, params.x=rough, .y=metal
layout(binding = 2, std430) readonly buffer GeomTable { GeomDesc descs[]; };
layout(binding = 3, std430) readonly buffer Materials { Material mats[]; };
layout(binding = 4) uniform sampler2D textures[];
struct Light { vec4 posRange; vec4 colInt; vec4 dirSizeX; vec4 tanSizeY; };
layout(binding = 5, std430) readonly buffer Lights { Light lights[]; };
layout(binding = 6, rgba32f) uniform image2D accumImage; // persistent radiance accumulator

layout(push_constant) uniform PC {
    mat4  invViewProj;
    vec4  camPos;
    uvec2 dims;
    uint  hasTlas;
    uint  numLights;
    vec4  sunDir; // xyz dir, w intensity
    vec4  sunCol; // rgb color, w = accumulated frame index
} pc;

const float PI = 3.14159265;
const int   MAX_BOUNCES = 4;

vec3 sky(vec3 dir) {
    float t = clamp(dir.z * 0.5 + 0.5, 0.0, 1.0);
    return mix(vec3(0.90, 0.93, 0.98), vec3(0.22, 0.42, 0.85), t);
}
vec3 hashColor(uint i) {
    return 0.35 + 0.55 * vec3(
        fract(sin(float(i) * 12.9898) * 43758.5453),
        fract(sin(float(i) * 78.2330) * 43758.5453),
        fract(sin(float(i) * 37.7190) * 43758.5453));
}

vec3 v3(Verts b, uint i) { return vec3(b.v[i*3u], b.v[i*3u+1u], b.v[i*3u+2u]); }
vec3 n3(Norms b, uint i) { return vec3(b.n[i*3u], b.n[i*3u+1u], b.n[i*3u+2u]); }
vec2 t2(Uvs   b, uint i) { return vec2(b.u[i*2u], b.u[i*2u+1u]); }

// PCG hash RNG (scalar).
uint  pcg(inout uint s) { s = s*747796405u + 2891336453u; uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u; return (w >> 22u) ^ w; }
float rnd(inout uint s) { return float(pcg(s)) * (1.0 / 4294967296.0); }
// PCG3D: decorrelated 2D random (less structured noise than scalar PCG pairs) — ignis-web.
uvec3 pcg3d(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y*v.z; v.y += v.z*v.x; v.z += v.x*v.y;
    v ^= v >> 16u;
    v.x += v.y*v.z; v.y += v.z*v.x; v.z += v.x*v.y;
    return v;
}
vec2 rand2(inout uint s) {
    s = s * 747796405u + 2891336453u;
    uvec3 h = pcg3d(uvec3(s, s*16807u, s*48271u));
    return vec2(h.xy) * (1.0 / 4294967295.0);
}

mat3 build_onb(vec3 n) {
    vec3 up = abs(n.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0);
    vec3 t = normalize(cross(up, n));
    vec3 b = cross(n, t);
    return mat3(t, b, n);
}

vec3 cosineHemisphere(vec3 N, vec2 u) {
    float phi = 2.0 * PI * u.x;
    float sr = sqrt(u.y);
    vec3 local = vec3(cos(phi)*sr, sin(phi)*sr, sqrt(max(0.0, 1.0 - u.y)));
    return normalize(build_onb(N) * local);
}

// GGX VNDF sampling (Heitz) — returns the microfacet normal H. Port from ignis-web.
vec3 sampleGgxVndf(vec2 u, vec3 V, vec3 N, float alpha) {
    mat3 onb = build_onb(N);
    vec3 T1 = onb[0], T2 = onb[1];
    vec3 Vh = normalize(vec3(dot(V,T1)*alpha, dot(V,T2)*alpha, dot(V,N)));
    float lensq = Vh.x*Vh.x + Vh.y*Vh.y;
    vec3 T1h = lensq > 0.0 ? vec3(-Vh.y, Vh.x, 0.0) * inversesqrt(lensq) : vec3(1,0,0);
    vec3 T2h = cross(Vh, T1h);
    float r = sqrt(u.x);
    float phi = 2.0 * PI * u.y;
    float t1 = r * cos(phi);
    float t2 = r * sin(phi);
    float s = 0.5 * (1.0 + Vh.z);
    t2 = (1.0 - s) * sqrt(max(0.0, 1.0 - t1*t1)) + s * t2;
    vec3 Nh = t1*T1h + t2*T2h + sqrt(max(0.0, 1.0 - t1*t1 - t2*t2)) * Vh;
    return normalize(T1*(alpha*Nh.x) + T2*(alpha*Nh.y) + N*max(0.0, Nh.z));
}

float smithG1(float NdotX, float alpha) {
    float a2 = alpha * alpha;
    return 2.0 * NdotX / (NdotX + sqrt(a2 + (1.0 - a2) * NdotX * NdotX));
}

float ggxD(float NdotH, float alpha) {
    float a2 = alpha * alpha;
    float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d);
}

// Cook-Torrance BRDF value (diffuse + GGX specular) for a light direction. Multiply by
// (radiance * NdotL) for the contribution. Diffuse keeps the existing (un-divided-by-pi)
// convention; specular is the standard D*G*F/(4 NdotV NdotL).
vec3 brdf(vec3 N, vec3 V, vec3 Ldir, vec3 diffAlbedo, vec3 F0, float alpha) {
    float nl = max(dot(N, Ldir), 1e-4);
    float nv = max(dot(N, V), 1e-4);
    vec3 H = normalize(V + Ldir);
    float nh = max(dot(N, H), 0.0);
    float vh = max(dot(V, H), 0.0);
    vec3 F = F0 + (1.0 - F0) * pow(1.0 - vh, 5.0);
    float G = smithG1(nv, alpha) * smithG1(nl, alpha);
    vec3 spec = ggxD(nh, alpha) * G * F / (4.0 * nv * nl);
    return diffAlbedo + spec;
}

// Sample a direction within a cone of half-angle acos(cosThetaMax) around `axis`.
vec3 sample_cone(vec3 axis, float cosThetaMax, vec2 u) {
    float ct = 1.0 + u.x * (cosThetaMax - 1.0);
    float st = sqrt(max(0.0, 1.0 - ct * ct));
    float phi = 2.0 * PI * u.y;
    return normalize(build_onb(axis) * vec3(cos(phi)*st, sin(phi)*st, ct));
}

bool occluded(vec3 o, vec3 d, float tmax) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFFu, o, 0.001, d, tmax);
    while (rayQueryProceedEXT(rq)) {}
    return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// Surface attributes at a committed triangle hit.
void getSurface(uint id, uint prim, vec2 bc, mat4x3 o2w, vec3 rd,
                out vec3 N, out vec3 albedo, out float roughness, out float metallic) {
    GeomDesc gd = descs[id];
    N = -rd;
    roughness = 1.0; // no material -> fully rough (diffuse)
    metallic = 0.0;
    vec2 uvCoord = vec2(0.0);
    float w0 = 1.0 - bc.x - bc.y;
    if (gd.idx != 0ul) {
        Indices ib = Indices(gd.idx);
        uint i0 = ib.i[prim*3u+0u], i1 = ib.i[prim*3u+1u], i2 = ib.i[prim*3u+2u];
        vec3 no;
        if (gd.nrm != 0ul) {
            Norms nb = Norms(gd.nrm);
            no = n3(nb,i0)*w0 + n3(nb,i1)*bc.x + n3(nb,i2)*bc.y;
        } else if (gd.vtx != 0ul) {
            Verts vb = Verts(gd.vtx);
            no = cross(v3(vb,i1)-v3(vb,i0), v3(vb,i2)-v3(vb,i0));
        } else {
            no = -rd;
        }
        N = normalize(mat3(o2w) * no);
        if (gd.uv != 0ul) {
            Uvs ub = Uvs(gd.uv);
            uvCoord = t2(ub,i0)*w0 + t2(ub,i1)*bc.x + t2(ub,i2)*bc.y;
            uvCoord.y = 1.0 - uvCoord.y; // Blender bottom-left -> Vulkan top-left
        }
    }
    if (dot(N, rd) > 0.0) N = -N; // face-forward to the incoming ray
    albedo = hashColor(id);
    if (gd.mat != 0ul) {
        Material mat = mats[MatIds(gd.mat).m[prim]];
        albedo = mat.albedo.rgb;
        if (mat.tex.x != 0xFFFFFFFFu) albedo = texture(textures[nonuniformEXT(mat.tex.x)], uvCoord).rgb;
        roughness = clamp(mat.params.x, 0.04, 1.0);
        metallic = clamp(mat.params.y, 0.0, 1.0);
    }
}

// Direct lighting (NEE): sun + scene lights, each shadow-tested, with full diffuse+GGX BRDF
// so glossy/metal surfaces get specular highlights (glints) from the lights.
vec3 directShade(vec3 hitPos, vec3 N, vec3 V, vec3 diffAlbedo, vec3 F0, float alpha, inout uint rng) {
    vec3 o = hitPos + N * 0.002;
    vec3 sum = vec3(0.0);
    // Sun — cone-sampled within its angular radius (cam_pos.w) for soft shadows.
    vec3 sunDir = normalize(pc.sunDir.xyz);
    float sunSize = pc.camPos.w;
    if (sunSize > 1e-4) sunDir = sample_cone(sunDir, cos(sunSize), rand2(rng));
    float ndl = max(dot(N, sunDir), 0.0);
    if (ndl > 0.0 && !occluded(o, sunDir, 10000.0)) {
        vec3 Li = pc.sunCol.rgb * min(pc.sunDir.w, 4.0);
        sum += brdf(N, V, sunDir, diffAlbedo, F0, alpha) * Li * ndl;
    }
    // Scene lights. Area lights (range < 0) sample a random point on the rectangle for
    // soft shadows; point lights use the center (hard).
    for (uint li = 0u; li < pc.numLights; li++) {
        Light L = lights[li];
        vec3 lpos = L.posRange.xyz;
        if (L.posRange.w < 0.0) {
            vec3 tang = L.tanSizeY.xyz;
            vec3 bitan = cross(L.dirSizeX.xyz, tang);
            vec2 r = rand2(rng);
            lpos += tang * ((r.x - 0.5) * L.dirSizeX.w) + bitan * ((r.y - 0.5) * L.tanSizeY.w);
        }
        vec3 toL = lpos - o;
        float dist = length(toL);
        if (L.posRange.w > 0.0 && dist > L.posRange.w) continue;
        vec3 Ldir = toL / max(dist, 1e-4);
        float nl = max(dot(N, Ldir), 0.0);
        if (nl <= 0.0 || occluded(o, Ldir, dist - 0.01)) continue;
        vec3 Li = L.colInt.rgb * L.colInt.w / (dist*dist + 1e-3);
        sum += brdf(N, V, Ldir, diffAlbedo, F0, alpha) * Li * nl;
    }
    return sum;
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.dims.x || p.y >= pc.dims.y) return;
    uint frame = uint(pc.sunCol.w);
    uint rng = ((p.x * 1973u) ^ (p.y * 9277u) ^ ((frame + 1u) * 26699u)) | 1u;

    // Primary ray, with sub-pixel jitter for free anti-aliasing across accumulation.
    vec2 jitter = (frame == 0u) ? vec2(0.5) : rand2(rng);
    vec2 uv  = (vec2(p) + jitter) / vec2(pc.dims);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 world = pc.invViewProj * vec4(ndc, 1.0, 1.0);

    vec3 L = vec3(0.0);
    if (pc.hasTlas == 1u && abs(world.w) >= 1e-8) {
        world /= world.w;
        vec3 ro = pc.camPos.xyz;
        vec3 rd = normalize(world.xyz - ro);
        vec3 tp = vec3(1.0); // throughput

        for (int b = 0; b < MAX_BOUNCES; b++) {
            rayQueryEXT rq;
            rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFFu, ro, 0.001, rd, 1e30);
            while (rayQueryProceedEXT(rq)) {}
            if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
                L += tp * sky(rd); // ray escaped to the sky
                break;
            }
            uint id   = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
            uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
            vec2 bc   = rayQueryGetIntersectionBarycentricsEXT(rq, true);
            float thit = rayQueryGetIntersectionTEXT(rq, true);
            mat4x3 o2w = rayQueryGetIntersectionObjectToWorldEXT(rq, true);

            vec3 N, albedo;
            float roughness, metallic;
            getSurface(id, prim, bc, o2w, rd, N, albedo, roughness, metallic);
            vec3 hitPos = ro + rd * thit;

            vec3 diffAlbedo = albedo * (1.0 - metallic);
            vec3 V = -rd;
            vec3 F0 = mix(vec3(0.04), albedo, metallic);
            float alpha = max(roughness * roughness, 1e-3);

            // Direct lighting (diffuse + specular glints from sun/lights, soft shadows).
            L += tp * directShade(hitPos, N, V, diffAlbedo, F0, alpha, rng);

            // BRDF bounce: stochastically pick the diffuse or the GGX specular lobe.
            float lumD = dot(diffAlbedo, vec3(0.299, 0.587, 0.114));
            float lumS = dot(F0, vec3(0.299, 0.587, 0.114));
            float pSpec = clamp(lumS / (lumS + lumD + 1e-4), 0.1, 0.9);
            vec2 u = rand2(rng);
            ro = hitPos + N * 0.002;
            if (rnd(rng) < pSpec) {
                vec3 H = sampleGgxVndf(u, V, N, alpha);
                vec3 Ldir = reflect(rd, H);
                if (dot(Ldir, N) <= 0.0) break;
                float VdotH = max(dot(V, H), 0.0);
                vec3 F = F0 + (1.0 - F0) * pow(1.0 - VdotH, 5.0);
                // VNDF estimator: BRDF*cos/pdf simplifies to F * G1(L).
                tp *= F * smithG1(max(dot(N, Ldir), 0.0), alpha) / pSpec;
                rd = Ldir;
            } else {
                rd = cosineHemisphere(N, u);
                tp *= diffAlbedo / (1.0 - pSpec);
            }

            // Russian roulette after a couple of bounces.
            if (b >= 2) {
                float q = clamp(max(tp.r, max(tp.g, tp.b)), 0.05, 1.0);
                if (rnd(rng) > q) break;
                tp /= q;
            }
        }
    } else {
        // No scene yet: show the sky through the primary ray.
        vec3 rd = (abs(world.w) >= 1e-8) ? normalize(world.xyz / world.w - pc.camPos.xyz) : vec3(0,0,1);
        L = sky(rd);
    }

    // Firefly clamp: cap a single sample's radiance so rare bright paths don't dominate
    // (mild bias, big noise reduction — they converge very slowly otherwise).
    L = min(L, vec3(16.0));

    // Temporal accumulation: average this frame's estimate into the running sum.
    vec3 accum = (frame == 0u) ? L : imageLoad(accumImage, ivec2(p)).rgb + L;
    imageStore(accumImage, ivec2(p), vec4(accum, 1.0));
    imageStore(outImage, ivec2(p), vec4(accum / float(frame + 1u), 1.0));
}
