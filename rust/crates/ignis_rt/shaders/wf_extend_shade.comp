#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
#include "pathtracer_common.glsl"
#include "wf_pathstate.glsl"
// ── Wavefront path tracer — Stage 2: extend + shade (per-bounce) ─────────────────────────────────
// One dispatch = one real bounce per live path. Load PathCtx; dead paths early-out (their radiance is
// already final in the buffer); else run a single traceBounce and store the updated state, flagging
// the path dead when it terminates. Dispatched MAX_BOUNCES times; the resolve stage reads c.L out.
// This is the wavefront split — paths die at different depths, so compaction (Phase 2) will skip the
// dead ones via an indirect dispatch. See the wavefront plan in memory.

layout(local_size_x = 64) in;

void main() {
    uint n = pc.dims.x * pc.dims.y;
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= wfc.c[pc.wfIn]) return;            // past this round's live-path count
    uint pixel = wfq.q[pc.wfIn * n + tid];        // the live path's pixel index (1 path/pixel)

    uint rng; float spreadAngle; bool dead;
    PathCtx c = loadPath(pixel, rng, spreadAngle, dead);
    if (dead) return; // born-dead (empty scene): nothing to do, and don't re-append

    g_sampleIdx = uint(pc.sunCol.w);
    // The injected raster primary hit applies only to the first real bounce (c.b == 0).
    uint rInst = 0u, rPrim = 0u; vec2 rBc = vec2(0.0); vec3 rPos = vec3(0.0);
    bool rasterFirst = (c.b == 0) && loadRasterHit(pixel, rInst, rPrim, rBc, rPos);
    // SHARC: carry the update state across bounces; ~4% of pixels populate the cache, the rest query it.
    SharcState sharc = loadSharcState(pixel);
    bool sharcUpdate = pc.sharcCapacity > 0u
        && isSharcUpdatePixel(uvec2(pixel % pc.dims.x, pixel / pc.dims.x), uint(pc.sunCol.w));
    bool alive = traceBounce(c, spreadAngle, rng, rasterFirst, rInst, rPrim, rBc, rPos, sharc, sharcUpdate);
    storeSharcState(pixel, sharc);
    storePath(pixel, c, rng, spreadAngle, !alive);

    if (alive) {                                  // survivor → append to the next round's queue
        uint slot = atomicAdd(wfc.c[pc.wfOut], 1u);
        wfq.q[pc.wfOut * n + slot] = pixel;
    }
}
