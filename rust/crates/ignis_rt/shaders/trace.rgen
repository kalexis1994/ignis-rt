#version 460
#extension GL_EXT_ray_tracing : require
#ifdef USE_SER
#extension GL_NV_shader_invocation_reorder : require
#endif
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
// Path tracer (RT): a ray-generation shader using inline ray query traversal — moved off the
// compute megakernel so it can use Shader Execution Reordering (SER). Multi-bounce GI, NEE for the
// sun + scene lights + emissive triangles, cosine/GGX bounces, DLSS-RR guide buffers, temporal
// accumulation. One invocation per pixel via vkCmdTraceRaysKHR.

#include "pathtracer_common.glsl"

void main() {
    uvec2 p = gl_LaunchIDEXT.xy;
    if (p.x >= pc.dims.x || p.y >= pc.dims.y) return;
    uint frame = uint(pc.sunCol.w);
    bool hasTlas = (pc.hasTlas & 1u) != 0u;
    bool hasLut  = (pc.hasTlas & 2u) != 0u;
    bool rrMode  = (pc.hasTlas & 8u) != 0u; // DLSS Ray Reconstruction active this frame
    // Owen-scrambled Sobol: the frame is the temporal sample index; the per-pixel seed must NOT
    // include the frame (it's the scramble key, constant across frames so the LDS stays coherent).
    g_sampleIdx = frame;
    uint rng = ((p.x * 1973u) ^ (p.y * 9277u) ^ 0x9e3779b9u) | 1u;

    // Primary ray, with sub-pixel jitter. In RR mode the jitter is the deterministic Halton offset
    // the CPU also feeds to NGX (so the denoiser knows the exact sample positions); otherwise it's a
    // random offset for free anti-aliasing across temporal accumulation.
    vec2 jitter = rrMode ? (vec2(0.5) + pc.jitter)
                         : ((frame == 0u) ? vec2(0.5) : rand2(rng));
    vec2 uv  = (vec2(p) + jitter) / vec2(pc.dims);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 world = pc.invViewProj * vec4(ndc, 1.0, 1.0);

    vec3 L = vec3(0.0);
    if (hasTlas && abs(world.w) >= 1e-8) {
        world /= world.w;
        vec3 ro = pc.camPos.xyz;
        vec3 rd = normalize(world.xyz - ro);
        // Ray cone for texture LOD: the angular size of one pixel (from the y-neighbour primary ray).
        // The cone width accumulates with path distance; getSurface turns it into a mip level.
        vec2 uvY = (vec2(p) + jitter + vec2(0.0, 1.0)) / vec2(pc.dims);
        vec4 wY = pc.invViewProj * vec4(uvY.x * 2.0 - 1.0, 1.0 - uvY.y * 2.0, 1.0, 1.0);
        float spreadAngle = length(normalize(wY.xyz / wY.w - ro) - rd);
        // DLSS-RR guide buffers: a separate deterministic PSR walk (mirror/glass aware), so reflected
        // and refracted content gets correct virtual depth/motion and stops shimmering.
        if (rrMode) writeGuidePSR(p, ro, rd, false, 0u, 0u, vec2(0.0), vec3(0.0));
        L = tracePath(ro, rd, spreadAngle, rng, pc.sharcCapacity > 0u && isSharcUpdatePixel(p, frame));
    } else {
        // No scene yet: show the sky through the primary ray.
        vec3 rd = (abs(world.w) >= 1e-8) ? normalize(world.xyz / world.w - pc.camPos.xyz) : vec3(0,0,1);
        L = sky(rd);
    }

    // DEBUG: write the raw path-class color (no accumulation, no tonemap) and stop.
    if (DEBUG_PATH) {
        imageStore(outImage, ivec2(p), vec4(L, 1.0));
        return;
    }

    // DLSS Ray Reconstruction: emit the noisy 1-spp *linear* radiance (no accumulation, no tonemap).
    // NGX denoises temporally using the guide buffers + motion vectors; we tonemap its clean output
    // in a separate pass. Sanitize NaN/Inf and clamp to the fp16 range the RR input image holds.
    if (rrMode) {
        vec3 c = L;
        c = mix(c, vec3(0.0), isnan(c));
        c = mix(c, vec3(0.0), isinf(c));
        c = max(c, vec3(0.0));
        // Firefly clamp before the denoiser: scale the whole colour down (hue-preserving) when the
        // max channel exceeds the threshold. A rare bright specular sample — a metal reflecting the
        // sun in shadow — would otherwise smear into whitish blotches. Hue-preserving proportional
        // clamp, matching RTXPT's RR brightness clamp + the C++ clampRadiance (MAX_RADIANCE=30). The
        // real fix is MIS (proper weighting of BSDF samples that hit lights); this is the mitigation.
        const float MAX_RADIANCE = 30.0;
        float maxC = max(c.r, max(c.g, c.b));
        if (maxC > MAX_RADIANCE) c *= MAX_RADIANCE / maxC;
        imageStore(gNoisy, ivec2(p), vec4(c, 1.0));
        return;
    }

    // Firefly control now happens per-contribution inside the path (Cycles-style indirect clamp,
    // hue-preserving, direct exempt) — the old whole-sample per-channel min(L,16) both kept more
    // indirect energy than Cycles and desaturated bright coloured samples. Keep fp-safety only.
    L = mix(L, vec3(0.0), isnan(L));
    L = clamp(L, vec3(0.0), vec3(65504.0));

    // Temporal accumulation: average this frame's estimate into the running sum.
    vec3 accum = (frame == 0u) ? L : imageLoad(accumImage, ivec2(p)).rgb + L;
    imageStore(accumImage, ivec2(p), vec4(accum, 1.0));

    // Tonemap the averaged (linear) radiance through Blender's view-transform LUT.
    vec3 hdr = accum / float(frame + 1u);
    vec3 display = hasLut ? tonemapLut(hdr) : aces(hdr);
    imageStore(outImage, ivec2(p), vec4(display, 1.0));
}
