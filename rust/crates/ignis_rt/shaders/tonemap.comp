#version 460
// DLSS Ray Reconstruction final pass: take NGX's clean *linear HDR* output (gClean) and tonemap it
// through Blender's OCIO view-transform LUT into the display-ready offscreen image. Shares the
// trace.comp pipeline layout (same descriptor set + push constant block), so it only touches
// binding 0 (out), 7 (LUT) and 14 (clean); the other bindings are present but unused here.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0,  rgba32f) uniform image2D outImage;
layout(binding = 7)           uniform sampler3D lutTex;       // OCIO view-transform LUT (Blender)
layout(binding = 14, rgba16f) uniform image2D gClean;         // NGX denoised linear HDR color

layout(push_constant) uniform PC {
    mat4  invViewProj;
    vec4  camPos;
    uvec2 dims;
    uint  hasTlas;      // bit1 = LUT present
    uint  numLights;
    vec4  sunDir;
    vec4  sunCol;
    mat4  prevViewProj;
    vec2  jitter;
} pc;

// Identical to trace.comp's tonemap so RR and non-RR frames match.
vec3 tonemapLut(vec3 c) {
    c = max(c, vec3(1e-10));
    c = clamp(log2(c), -12.47393, 12.52607);
    c = (c - (-12.47393)) / (12.52607 - (-12.47393));
    return clamp(texture(lutTex, c).rgb, 0.0, 1.0);
}
vec3 aces(vec3 x) {
    return clamp((x*(2.51*x+0.03)) / (x*(2.43*x+0.59)+0.14), 0.0, 1.0);
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.dims.x || p.y >= pc.dims.y) return;
    bool hasLut = (pc.hasTlas & 2u) != 0u;
    vec3 hdr = imageLoad(gClean, ivec2(p)).rgb;
    vec3 display = hasLut ? tonemapLut(hdr) : aces(hdr);
    imageStore(outImage, ivec2(p), vec4(display, 1.0));
}
