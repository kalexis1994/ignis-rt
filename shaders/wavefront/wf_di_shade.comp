#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require

// ============================================================
// wf_di_shade.comp — RTXDI DI port Phase 4f, step 1.
//
// Consumes the post-spatial DI reservoir at set 2 b=3
// (written by wf_di_spatial), reconstructs the winning light
// sample, evaluates BSDF × Li × geometry at the primary hit,
// and atomic-adds the contribution × W into pixelRadiance's
// diffuse slot.
//
// Currently runs ADDITIVELY on top of wf_shade.comp's inline NEE
// (sun + local + emissive). With both paths firing, directly-lit
// primary surfaces appear ~2× as bright — that's the validation
// that the DI port is producing radiance. The inline NEE path
// will be gated off at bounce 0 in a follow-up commit so the
// final brightness scales correctly.
//
// Dielectric approximation: same as 4c-4e (metallic=0, specular
// Level=0.5) because ignis-rt's primaryGBuf doesn't carry those
// scalars yet. Direct comparison against inline NEE on metals
// will only be apples-to-apples once that gap closes.
// ============================================================

#include "../include/common.glsl"
#include "../include/pbr_brdf.glsl"
#include "../include/wf_lights.glsl"
#include "../include/wf_di_reservoir.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// ── set 0: scene ──
layout(binding = 2, set = 0) uniform CameraProperties {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 view;
    mat4 proj;
    mat4 viewPrev;
    mat4 projPrev;
    uvec4 parameters;
    vec4 jitterData;
    vec4 sunLight;
    vec4 ambientLight;
    vec4 skyLight;
    vec4 ptParams0;
    vec4 ptParams1;
    vec4 windParams;
    vec4 rainParams;
    vec4 dofParams;
    vec4 dofParams2;
    ivec4 jitterPattern[8];
    uint lightCount;
    uint lightPad0, lightPad1, lightPad2;
    vec4 lights[128];
    uint64_t sharcHashEntriesAddr;
    uint64_t sharcAccumulationAddr;
    uint64_t sharcResolvedAddr;
    uint sharcCapacity;
    float sharcSceneScale;
    float sharcRadianceScale;
    float sharcWarmupFactor;
} cam;

// ── set 1: wavefront (pixelRadiance + primaryGBuf) ──
layout(binding = 3, set = 1, scalar) buffer PixelRadianceBuffer {
    uint radDataU[];
} pixelRadiance;

layout(binding = 4, set = 1, scalar) buffer PrimaryGBufBuffer {
    float gbufData[];
} primaryGBuf;

// ── set 2: DI port ──
layout(binding = 0, set = 2, scalar) readonly buffer PolyLightsBuf      { WFLightInfo data[]; } polyLights;
layout(binding = 3, set = 2, std430) readonly buffer DIPolyFinalCurrBuf { vec4 data[]; }       diPolyFinalCurr;

layout(push_constant) uniform PC {
    uint width;
    uint height;
    uint frameIndex;
    uint lightCount;
} pc;

const uint WF_PRIMARY_GBUF_STRIDE = 26u;

// Atomic float add via CAS — same pattern as the rest of the
// wavefront accumulators (pixelRadiance is laid out as uints).
void atomicAddFloat(uint index, float value) {
    if (value == 0.0) return;
    uint expected = pixelRadiance.radDataU[index];
    uint desired;
    do {
        desired = floatBitsToUint(uintBitsToFloat(expected) + value);
    } while ((expected = atomicCompSwap(pixelRadiance.radDataU[index], expected, desired)) != desired);
}

WFDIReservoir loadFinalCurr(uint idx) {
    uint b = idx * 2u;
    return wf_di_reservoir_unpack(diPolyFinalCurr.data[b + 0u], diPolyFinalCurr.data[b + 1u]);
}

void reconstructSample(in WFLightInfo li, vec2 uv,
                         out vec3 samplePos, out vec3 sampleNormal) {
    if (li.type == WF_LIGHT_TYPE_TRIANGLE) {
        samplePos = li.base + li.edges0 * uv.x + li.edges1 * uv.y;
        vec3 c = cross(li.edges0, li.edges1);
        float len = length(c);
        sampleNormal = (len > 1e-8) ? (c / len) : vec3(0.0, 1.0, 0.0);
    } else if (li.type == WF_LIGHT_TYPE_DIRECTIONAL) {
        samplePos    = normalize(li.base) * 1e6;
        sampleNormal = -normalize(li.base);
    } else {
        samplePos    = li.base;
        sampleNormal = (li.type == WF_LIGHT_TYPE_SPOT) ? normalize(li.edges0)
                                                       : vec3(0.0, 1.0, 0.0);
    }
}

void evalBRDF(vec3 N, vec3 V, vec3 L,
              vec3 baseColor, float roughness, float metallic, float specularLevel,
              out vec3 diff, out vec3 spec) {
    evaluateCookTorrance(N, V, L, baseColor, roughness, metallic, specularLevel,
                          1.5, 0.0, diff, spec,
                          0.0, 0.0, 1.5,
                          0.0, vec3(0.0), 0.0,
                          0.0, vec3(0.0), vec3(0.0),
                          vec3(1.0), 0.0);
}

// Same shape as evalTargetPdfAt but keeps RGB instead of luminance.
vec3 evalLightContribAt(in WFLightInfo li, vec2 lightUV,
                         vec3 x_v, vec3 n_v, vec3 V,
                         vec3 baseColor, float roughness,
                         float metallic, float specularLevel) {
    if (li.type == WF_LIGHT_TYPE_DIRECTIONAL) {
        vec3 L = normalize(li.base);
        float ndl = dot(n_v, L);
        if (ndl <= 0.0) return vec3(0.0);
        vec3 dC, sC;
        evalBRDF(n_v, V, L, baseColor, roughness, metallic, specularLevel, dC, sC);
        return (dC + sC) * li.emission;
    }
    if (li.type == WF_LIGHT_TYPE_POINT || li.type == WF_LIGHT_TYPE_SPOT) {
        vec3 toL = li.base - x_v;
        float dist = length(toL);
        if (dist < 1e-4) return vec3(0.0);
        float range = (li.type == WF_LIGHT_TYPE_POINT) ? li.scalars.x : li.scalars.z;
        if (range > 0.0 && dist > range) return vec3(0.0);
        vec3 L = toL / dist;
        float ndl = dot(n_v, L);
        if (ndl <= 0.0) return vec3(0.0);

        float atten = 1.0;
        if (li.type == WF_LIGHT_TYPE_SPOT) {
            vec3 axis = normalize(li.edges0);
            float cosInner = li.scalars.x;
            float cosOuter = li.scalars.y;
            atten = smoothstep(cosOuter, cosInner, dot(-L, axis));
            if (atten <= 0.0) return vec3(0.0);
        }
        float falloff = 1.0 / (dist * dist + 0.01);
        float window = 1.0;
        if (range > 0.0) {
            window = clamp(1.0 - pow(dist / range, 4.0), 0.0, 1.0);
            window = window * window;
        }
        vec3 dC, sC;
        evalBRDF(n_v, V, L, baseColor, roughness, metallic, specularLevel, dC, sC);
        return (dC + sC) * li.emission * falloff * window * atten;
    }
    if (li.type == WF_LIGHT_TYPE_TRIANGLE) {
        vec3 samplePos, sampleNormal;
        reconstructSample(li, lightUV, samplePos, sampleNormal);
        vec3 toL = samplePos - x_v;
        float dist = length(toL);
        if (dist < 1e-4) return vec3(0.0);
        vec3 L = toL / dist;
        float ndl = dot(n_v, L);
        if (ndl <= 0.0) return vec3(0.0);
        float cosLight = dot(-L, sampleNormal);
        if (cosLight <= 0.0) return vec3(0.0);
        vec3 dC, sC;
        evalBRDF(n_v, V, L, baseColor, roughness, metallic, specularLevel, dC, sC);
        float G = cosLight / (dist * dist);
        return (dC + sC) * li.emission * G;
    }
    return vec3(0.0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.width) || pixel.y >= int(pc.height)) return;
    uint pixelIdx = uint(pixel.y) * pc.width + uint(pixel.x);

    uint gBase = pixelIdx * WF_PRIMARY_GBUF_STRIDE;
    vec3  n_v       = vec3(primaryGBuf.gbufData[gBase + 0u],
                            primaryGBuf.gbufData[gBase + 1u],
                            primaryGBuf.gbufData[gBase + 2u]);
    float roughness = primaryGBuf.gbufData[gBase + 3u];
    vec3  x_v       = vec3(primaryGBuf.gbufData[gBase + 4u],
                            primaryGBuf.gbufData[gBase + 5u],
                            primaryGBuf.gbufData[gBase + 6u]);
    float viewZ     = primaryGBuf.gbufData[gBase + 7u];
    vec3  baseColor = vec3(primaryGBuf.gbufData[gBase + 8u],
                            primaryGBuf.gbufData[gBase + 9u],
                            primaryGBuf.gbufData[gBase + 10u]);
    // Recover (metallic, specularLevel) packed by wf_shade at bounce 0
    // into pixelRadiance slot 7. Replaces the earlier dielectric guess
    // that was leaking diffuse contribution onto reflective surfaces.
    vec2 mat = unpackHalf2x16(pixelRadiance.radDataU[pixelIdx * 8u + 7u]);
    float metallic      = mat.x;
    float specularLevel = mat.y;

    bool primaryHit = (viewZ < -0.001) && dot(n_v, n_v) > 1e-6;
    if (!primaryHit) return;

    WFDIReservoir r = loadFinalCurr(pixelIdx);
    if (!wf_di_reservoir_is_valid(r) || r.W <= 0.0 || r.lightIdx >= pc.lightCount) return;
    if (r.stableId == 0u || polyLights.data[r.lightIdx].stableId != r.stableId) return;

    WFLightInfo li = polyLights.data[r.lightIdx];
    vec3 cameraPos = cam.viewInverse[3].xyz;
    vec3 V         = normalize(cameraPos - x_v);
    vec3 contrib   = evalLightContribAt(li, r.lightUV,
                                          x_v, n_v, V,
                                          baseColor, roughness, metallic, specularLevel);
    if (contrib.r <= 0.0 && contrib.g <= 0.0 && contrib.b <= 0.0) return;

    vec3 finalContrib = contrib * r.W;
    finalContrib = min(finalContrib, vec3(WF_DI_FIREFLY_CLAMP));
    if (any(isnan(finalContrib)) || any(isinf(finalContrib))) return;

    // pixelRadiance stride = 8 floats / pixel (diffuse R/G/B + specular R/G/B + 2 pad).
    // Slot 0..2 = diffuse accumulator (matches inline NEE writes).
    uint rBase = pixelIdx * 8u;
    atomicAddFloat(rBase + 0u, finalContrib.r);
    atomicAddFloat(rBase + 1u, finalContrib.g);
    atomicAddFloat(rBase + 2u, finalContrib.b);
}
