#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
// RTXDI boiling filter — subgroup reductions over the 8x8 tile.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require

layout(local_size_x = 8, local_size_y = 8) in;

// Scene data (set 0)
layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 2, set = 0) uniform CameraProperties {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 view;
    mat4 proj;
    mat4 viewPrev;
    mat4 projPrev;
    uvec4 parameters;
    vec4 jitterData;
    vec4 sunLight;
    vec4 ambientLight;
    vec4 skyLight;
    vec4 ptParams0;
    vec4 ptParams1;
    vec4 windParams;
    vec4 rainParams;
    vec4 dofParams;
    vec4 dofParams2;
    ivec4 jitterPattern[8];
    uint lightCount;
    uint lightPad0, lightPad1, lightPad2;
    vec4 lights[128];
    uint64_t sharcHashEntriesAddr;
    uint64_t sharcAccumulationAddr;
    uint64_t sharcResolvedAddr;
    uint sharcCapacity;
    float sharcSceneScale;
    float sharcRadianceScale;
    float sharcWarmupFactor;
} cam;

// Previous-frame instance transforms (for motion vectors)
layout(binding = 28, set = 0, std430) buffer PrevTransformBuf {
    vec4 data[];
} prevTransforms;

// ReSTIR PT buffers (set 1)
layout(binding = 15, set = 1, std430) buffer PTResCurrBuf  { vec4 data[]; } ptResCurr;
layout(binding = 16, set = 1, std430) buffer PTResPrevBuf  { vec4 data[]; } ptResPrev;
layout(binding = 17, set = 1, std430) buffer PTPathBuf     { vec4 data[]; } ptPathRec;

// Primary G-buffer (for motion vector computation)
layout(binding = 4, set = 1, scalar) buffer PrimaryGBufBuffer { float gbufData[]; } primaryGBuf;

// Surface history (previous frame) — written by K5 (wf_output) of frame N-1.
// 5 uints/pixel: validFlags, instanceId, materialId, primitiveId, customIndex.
const uint WF_SURFACE_HISTORY_STRIDE = 5u;
layout(binding = 20, set = 1, std430) readonly buffer SurfaceHistoryPrevBuf {
    uint data[];
} surfaceHistoryPrev;

layout(push_constant) uniform PushConst {
    uint width;
    uint height;
    uint frameIndex;
    uint pad0;
} pc;

#include "../include/common.glsl"
#include "../include/pt_reservoir.glsl"
#include "../include/pt_replay.glsl"
#include "../include/wf_boiling_filter.glsl"

// Boiling-filter aggressiveness for PT reservoirs. RTXPT uses 0.2 for DI; PT
// inherits the same default — multiplier ≈41× the tile non-zero mean weight.
const float WF_PT_BOILING_STRENGTH = 0.2;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    // No early-return: the boiling filter uses workgroup barriers and subgroup
    // reductions, so every lane in the 8×8 tile must reach the filter call.
    bool inBounds = (pixel.x < int(pc.width) && pixel.y < int(pc.height));

    int pixelIdx = inBounds ? (pixel.y * int(pc.width) + pixel.x) : 0;
    ivec2 launchSize = ivec2(pc.width, pc.height);

    PTReservoir curr = ptEmptyReservoir();

    if (inBounds) {
    // ── Read path record from current frame's K2 shade ──
    PTPathRecord pr;
    {
        int pb = pixelIdx * 6;
        vec4 d0 = ptPathRec.data[pb+0];
        vec4 d1 = ptPathRec.data[pb+1];
        vec4 d2 = ptPathRec.data[pb+2];
        vec4 d3 = ptPathRec.data[pb+3];
        vec4 d4 = ptPathRec.data[pb+4];
        vec4 d5 = ptPathRec.data[pb+5];
        pr.primaryPos = d0.xyz; pr.primaryRoughness = d0.w;
        pr.primaryNormal = ptOctDecode(d1.xy);
        pr.primaryInstanceId = floatBitsToUint(d1.z); pr.rngSeed = floatBitsToUint(d1.w);
        pr.rcPos = d2.xyz; pr.rcDist = d2.w;
        pr.rcRadiance = d3.xyz; pr.pathRadianceLum = d3.w;
        pr.rcNormal = ptOctDecode(d4.xy);
        pr.rcBounce = floatBitsToUint(d4.z); pr.rcValid = (d4.w > 0.5);
        pr.lightType = floatBitsToUint(d5.x); pr.lightIndex = floatBitsToUint(d5.y);
    }
    float cachedPJ = ptPathRec.data[pixelIdx * 6 + 5].z;
    float rcPdf = ptPathRec.data[pixelIdx * 6 + 5].w;

    // Create initial reservoir from current frame's path
    curr = ptCreateFromPathRecord(pr, cachedPJ, rcPdf);

    // Populate source-vertex attrs from this pixel's primary G-buffer.
    // For rcBounceDepth=1 the source IS the primary surface — exact.
    // For deeper paths it's an approximation that matches what wf_shade
    // recorded (the path tracer doesn't yet persist per-bounce surface
    // state), but pt_replay's sameSource check stays self-consistent.
    {
        uint gB = uint(pixelIdx) * 26u;
        curr.sourcePos = pr.primaryPos;
        curr.sourceNormal = pr.primaryNormal;
        curr.sourceRoughness = pr.primaryRoughness;
        vec3 primAlbedo = vec3(primaryGBuf.gbufData[gB+8],
                                primaryGBuf.gbufData[gB+9],
                                primaryGBuf.gbufData[gB+10]);
        curr.sourceAlbedoLuma = ptLuminance(primAlbedo);
        // metallic/specularLevel aren't in the gbuf at this resolution;
        // use neutral defaults — matches the placeholder wf_shade pattern.
        curr.sourceMetallic = 0.0;
        curr.sourceSpecularLevel = 0.5;
        curr.prefixThroughput = primAlbedo;
    }

    // ── Temporal resampling: reproject to previous frame ──
    if (curr.M > 0.0) {
        // Compute motion vector from primary surface
        uint instId = pr.primaryInstanceId;
        uint gBase = uint(pixelIdx) * 26u;
        vec3 localPos = vec3(primaryGBuf.gbufData[gBase+12],
                              primaryGBuf.gbufData[gBase+13],
                              primaryGBuf.gbufData[gBase+14]);

        vec4 currClip = cam.proj * cam.view * vec4(pr.primaryPos, 1.0);
        vec2 currNDC = currClip.xy / currClip.w;
        vec2 currUV = vec2(currNDC.x * 0.5 + 0.5, 0.5 - currNDC.y * 0.5);

        uint tBase = instId * 3u;
        vec4 pRow0 = prevTransforms.data[tBase + 0u];
        vec4 pRow1 = prevTransforms.data[tBase + 1u];
        vec4 pRow2 = prevTransforms.data[tBase + 2u];
        vec3 prevWorldPos = vec3(dot(pRow0, vec4(localPos, 1.0)),
                                  dot(pRow1, vec4(localPos, 1.0)),
                                  dot(pRow2, vec4(localPos, 1.0)));
        vec4 prevClip = cam.projPrev * cam.viewPrev * vec4(prevWorldPos, 1.0);
        vec2 prevNDC = prevClip.xy / prevClip.w;
        vec2 prevUV = vec2(prevNDC.x * 0.5 + 0.5, 0.5 - prevNDC.y * 0.5);

        // Find previous-frame pixel
        if (prevUV.x >= 0.0 && prevUV.x < 1.0 && prevUV.y >= 0.0 && prevUV.y < 1.0) {
            ivec2 prevPixel = ivec2(prevUV * vec2(launchSize));
            int prevIdx = prevPixel.y * int(pc.width) + prevPixel.x;

            // ── Surface history veto (RTXPT-style) ──
            // If the pixel that prevUV reprojects to belonged to a different
            // instance/primitive last frame, skip the temporal merge — the
            // surface revealed by camera motion has no shared radiance with
            // whatever object covered the same pixel a frame ago.
            uint myPrimId    = floatBitsToUint(primaryGBuf.gbufData[gBase+24]);
            uint myCustomIdx = floatBitsToUint(primaryGBuf.gbufData[gBase+25]);
            uint shBase = uint(prevIdx) * WF_SURFACE_HISTORY_STRIDE;
            bool prevValid = (surfaceHistoryPrev.data[shBase + 0u] & 1u) != 0u;
            bool surfaceMatch = prevValid &&
                surfaceHistoryPrev.data[shBase + 1u] == instId &&
                surfaceHistoryPrev.data[shBase + 3u] == myPrimId &&
                surfaceHistoryPrev.data[shBase + 4u] == myCustomIdx;
            if (surfaceMatch) {

            // Load previous reservoir (10 vec4 stride — slots 7-9 hold the
            // source-vertex attrs used by pt_replay's sameSource check)
            PTReservoir prev;
            {
                int rb = prevIdx * 10;
                prev.rcVertexPos = ptResPrev.data[rb+0].xyz; prev.weightSum = ptResPrev.data[rb+0].w;
                prev.rcRadiance = ptResPrev.data[rb+1].xyz; prev.M = ptResPrev.data[rb+1].w;
                prev.rcVertexNormal = ptOctDecode(ptResPrev.data[rb+2].xy);
                prev.targetFunction = ptResPrev.data[rb+2].z;
                prev.rcBounceDepth = floatBitsToUint(ptResPrev.data[rb+2].w);
                prev.rngSeed = floatBitsToUint(ptResPrev.data[rb+3].x);
                prev.lightType = floatBitsToUint(ptResPrev.data[rb+3].y);
                prev.lightIndex = floatBitsToUint(ptResPrev.data[rb+3].z);
                prev.age = ptResPrev.data[rb+3].w;
                prev.primaryPos = ptResPrev.data[rb+4].xyz;
                prev.primaryRoughness = ptResPrev.data[rb+4].w;
                prev.primaryNormal = ptOctDecode(ptResPrev.data[rb+5].xy);
                prev.partialJacobian = ptResPrev.data[rb+6].x;
                prev.rcWiPdf = ptResPrev.data[rb+6].y;
                prev.pathLength = floatBitsToUint(ptResPrev.data[rb+6].z);
                // Source-vertex attrs (slots 7-9, new for pt_replay).
                prev.sourcePos = ptResPrev.data[rb+7].xyz;
                prev.sourceRoughness = ptResPrev.data[rb+7].w;
                prev.sourceNormal = ptOctDecode(ptResPrev.data[rb+8].xy);
                prev.sourceAlbedoLuma = ptResPrev.data[rb+8].z;
                prev.sourceMetallic = ptResPrev.data[rb+8].w;
                prev.sourceSpecularLevel = ptResPrev.data[rb+9].x;
                prev.prefixThroughput = ptResPrev.data[rb+9].yzw;
            }

            // Validate: surface similarity + age + non-empty + no NaN.
            if (prev.M > 0.0 && prev.age < 30.0 &&
                !any(isnan(prev.rcRadiance)) && !any(isinf(prev.rcRadiance)) &&
                ptSurfaceSimilar(pr.primaryNormal, prev.primaryNormal,
                                  pr.primaryRoughness, prev.primaryRoughness,
                                  pr.primaryPos, prev.primaryPos)) {

                prev.M = min(prev.M, 20.0);
                prev.age += 1.0;
                prev.rcRadiance = min(prev.rcRadiance, vec3(20.0));

                // ── Deep prefix replay (RTXPT-style) ──
                // Re-traces the prefix from this pixel's primary using prev's
                // RNG seed, reconstructs the surface at every bounce from
                // geometry+material buffers, and rejects the reuse if the
                // shifted source vertex doesn't materially match prev.source*.
                // This is what eliminates light leak across walls that the
                // previous approximate replay used to allow.
                vec3 shiftedReceiverPos, shiftedReceiverNormal;
                vec3 shiftedReceiverAlbedo, shiftedPrefixThroughput;
                float shiftedReceiverRoughness, shiftedReceiverMetallic, shiftedReceiverSpecular;
                bool replayValid = ptReplayDeepPrefix(prev,
                    pr.primaryPos, pr.primaryNormal,
                    curr.prefixThroughput,                  // primary albedo (we stored it here)
                    pr.primaryRoughness, curr.sourceMetallic, curr.sourceSpecularLevel,
                    shiftedReceiverPos, shiftedReceiverNormal,
                    shiftedReceiverAlbedo,
                    shiftedReceiverRoughness, shiftedReceiverMetallic, shiftedReceiverSpecular,
                    shiftedPrefixThroughput);

                // ── Jacobian: geometry term ratio at shifted receiver ──
                float J = 0.0;
                if (replayValid) {
                    if (prev.partialJacobian > 0.0) {
                        J = ptJacobianCached(shiftedReceiverPos, prev);
                    } else {
                        J = ptJacobian(prev.rcVertexPos, prev.rcVertexNormal,
                                        shiftedReceiverPos, prev.primaryPos);
                    }
                    if (J < 0.001) J = 0.0;
                }

                // ── Invertibility at shifted receiver ──
                bool invertible = replayValid && ptValidateInvertibility(
                    shiftedReceiverPos, shiftedReceiverNormal, shiftedReceiverRoughness, prev);

                // ── Visibility: shadow ray from shifted receiver to rcVertex ──
                bool visible = true;
                if (J > 0.0 && invertible) {
                    vec3 toRC = prev.rcVertexPos - shiftedReceiverPos;
                    float rcDist = length(toRC);
                    if (rcDist > 0.01) {
                        vec3 rcDir = toRC / rcDist;
                        rayQueryEXT visRQ;
                        rayQueryInitializeEXT(visRQ, topLevelAS,
                            gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
                            0xFF, shiftedReceiverPos + shiftedReceiverNormal * 0.002,
                            0.001, rcDir, rcDist - 0.01);
                        while (rayQueryProceedEXT(visRQ)) {}
                        visible = (rayQueryGetIntersectionTypeEXT(visRQ, true) ==
                                   gl_RayQueryCommittedIntersectionNoneEXT);
                    }
                }

                float pHat = ptTargetPDF(prev);
                // Zero out target if any validation failed
                if (!invertible || !visible || J < 0.001) pHat = 0.0;

                if (pHat > 0.001) {
                    rngState = uint(pixelIdx) ^ pc.frameIndex * 747796405u;
                    rngState = pcg(rngState);
                    float rng = rand01();

                    // Apply Jacobian to weight before merge
                    prev.weightSum *= J;
                    ptReservoirMerge(curr, prev, pHat, rng);
                }
            }
            } // end if (surfaceMatch) — surface history veto
        }
    }

    // Finalize reservoir: convert weightSum to contribution weight W
    ptFinalizeReservoir(curr);
    } // end if (inBounds)

    // ── RTXDI boiling filter ──
    // Reservoir-agnostic proxy: targetFunction · weightSum. Out-of-bounds /
    // empty / NaN lanes contribute 0 but must still execute the subgroup
    // reductions, so this block is OUTSIDE the inBounds gate.
    {
        float bfWeight = (!inBounds || curr.M <= 0.0)
            ? 0.0
            : (curr.targetFunction * curr.weightSum);
        bool isBoiling = wf_boiling_filter(gl_LocalInvocationID.xy,
                                            WF_PT_BOILING_STRENGTH,
                                            bfWeight);
        if (inBounds && isBoiling) {
            curr = ptEmptyReservoir();
        }
    }

    // Write current reservoir (10 vec4 stride — slots 7-9 are the source vertex)
    if (inBounds) {
        int rb = pixelIdx * 10;
        vec2 rcN = ptOctEncode(curr.rcVertexNormal);
        vec2 pN  = ptOctEncode(curr.primaryNormal);
        vec2 sN  = ptOctEncode(curr.sourceNormal);
        ptResCurr.data[rb+0] = vec4(curr.rcVertexPos, curr.weightSum);
        ptResCurr.data[rb+1] = vec4(curr.rcRadiance, curr.M);
        ptResCurr.data[rb+2] = vec4(rcN, curr.targetFunction, uintBitsToFloat(curr.rcBounceDepth));
        ptResCurr.data[rb+3] = vec4(uintBitsToFloat(curr.rngSeed), uintBitsToFloat(curr.lightType),
                                     uintBitsToFloat(curr.lightIndex), curr.age);
        ptResCurr.data[rb+4] = vec4(curr.primaryPos, curr.primaryRoughness);
        ptResCurr.data[rb+5] = vec4(pN, 0.0, 0.0);
        ptResCurr.data[rb+6] = vec4(curr.partialJacobian, curr.rcWiPdf,
                                     uintBitsToFloat(curr.pathLength), 0.0);
        ptResCurr.data[rb+7] = vec4(curr.sourcePos, curr.sourceRoughness);
        ptResCurr.data[rb+8] = vec4(sN, curr.sourceAlbedoLuma, curr.sourceMetallic);
        ptResCurr.data[rb+9] = vec4(curr.sourceSpecularLevel, curr.prefixThroughput);
    }
}
